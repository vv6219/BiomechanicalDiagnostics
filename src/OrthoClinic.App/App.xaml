             xmlns:local="clr-namespace:OrthoClinic"
             x:Class="OrthoClinic.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#0284C7</Color>
            <Color x:Key="Secondary">#38BDF8</Color>
            <Color x:Key="Background">#0F172A</Color>
            <Color x:Key="Surface">#1E293B</Color>
            <Color x:Key="AlertRed">#EF4444</Color>
            <Color x:Key="SuccessGreen">#10B981</Color>
        </ResourceDictionary>
    </Application.Resources>

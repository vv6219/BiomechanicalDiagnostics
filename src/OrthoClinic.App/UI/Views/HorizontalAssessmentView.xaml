<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:drawables="clr-namespace:OrthoClinic.UI.Drawables"
             xmlns:vm="clr-namespace:OrthoClinic.UI.ViewModels"
             xmlns:domain="clr-namespace:OrthoClinic.Core.Domain;assembly=OrthoClinic.Core"
             xmlns:converters="clr-namespace:OrthoClinic.UI.Converters"
             xmlns:views="clr-namespace:OrthoClinic.UI.Views"
             x:Class="OrthoClinic.UI.Views.HorizontalAssessmentView"
             x:DataType="vm:HorizontalTestsViewModel"
             BackgroundColor="#0F172A"
             Title="Клиническая диагностика и подбор клиньев">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NotNullConverter x:Key="NotNullConverter" />
            <converters:NotNullOrEmptyConverter x:Key="NotNullOrEmptyConverter" />
            <converters:AnatomicalSegmentToNameConverter x:Key="AnatomicalSegmentToNameConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <converters:EnumToColorConverter x:Key="EnumToColorConverter" />
            <converters:AlertSeverityToColorConverter x:Key="AlertSeverityToColorConverter" />
            <converters:AlertSeverityToBackgroundConverter x:Key="AlertSeverityToBackgroundConverter" />
            <converters:AlertSeverityToBadgeConverter x:Key="AlertSeverityToBadgeConverter" />
            <converters:KrsToColorConverter x:Key="KrsToColorConverter" />
            <converters:KrsToBadgeConverter x:Key="KrsToBadgeConverter" />
            <converters:HexColorToColorConverter x:Key="HexColorToColorConverter" />
            <converters:DurometerToBadgeConverter x:Key="DurometerToBadgeConverter" />
            <converters:QuadrantToBadgeConverter x:Key="QuadrantToBadgeConverter" />
            <converters:ClinicalProfileToColorConverter x:Key="ProfileColorConverter" />
            <converters:ClinicalProfileToBadgeConverter x:Key="ProfileBadgeConverter" />
            <converters:ApprovalStatusToColorConverter x:Key="ApprovalColorConverter" />
            <converters:ApprovalStatusToBadgeConverter x:Key="ApprovalBadgeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView Grid.Row="0">
        <VerticalStackLayout Padding="16" Spacing="18">

            <!-- ЗАГОЛОВОК КЛИНИЧЕСКОЙ СТАНЦИИ -->
            <Border BackgroundColor="#1E293B" Padding="14" Stroke="#334155" StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="ОРТОПЕДИЧЕСКАЯ РАБОЧАЯ СТАНЦИЯ" TextColor="#38BDF8" FontAttributes="Bold" FontSize="13" />
                        <Label Text="Горизонтальный протокол мануального тестирования" TextColor="#94A3B8" FontSize="11" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="#0F172A" Stroke="#38BDF8" Padding="8,4" StrokeShape="RoundRectangle 8">
                        <Label Text="Formthotics / .NET 10" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold" />
                    </Border>
                    <!-- Данные пациента -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                        <Entry Placeholder="ID Пациента" Text="{Binding PatientId}" TextColor="White" PlaceholderColor="#64748B" FontSize="12" BackgroundColor="#0F172A" HeightRequest="38" />
                        <Entry Grid.Column="1" Placeholder="ФИО Пациента" Text="{Binding PatientFullName}" TextColor="White" PlaceholderColor="#64748B" FontSize="12" BackgroundColor="#0F172A" HeightRequest="38" />
                    </Grid>

                    <!-- Биометрические параметры пациента для адаптивного протокола -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,6,0,0">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Возраст (лет)" TextColor="#94A3B8" FontSize="10"/>
                            <Entry Text="{Binding PatientAge}" Keyboard="Numeric" TextColor="White" BackgroundColor="#0F172A" HeightRequest="36" FontSize="12"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Вес (кг)" TextColor="#94A3B8" FontSize="10"/>
                            <Entry Text="{Binding PatientWeightKg}" Keyboard="Numeric" TextColor="White" BackgroundColor="#0F172A" HeightRequest="36" FontSize="12"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2">
                            <Label Text="Индекс BMI" TextColor="#94A3B8" FontSize="10"/>
                            <Entry Text="{Binding PatientBmi}" Keyboard="Numeric" TextColor="White" BackgroundColor="#0F172A" HeightRequest="36" FontSize="12"/>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>

            <!-- ШАГ 1: ОЦЕНКА ДЛИНЫ НОГ И ТОПОЛОГИЯ НАТЯЖЕНИЯ -->
            <Border BackgroundColor="#1E293B" Padding="14" Stroke="#334155" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Тест 1: Взаимное положение лодыжек (Кушетка)" TextColor="#38BDF8" FontAttributes="Bold" FontSize="14"/>
                        <Label Grid.Column="1" Text="{Binding CurrentDelta, StringFormat='ΔL: {0:F1} мм'}" TextColor="#F59E0B" FontAttributes="Bold" FontSize="13"/>
                    </Grid>

                    <GraphicsView x:Name="LegsGraphicsView" HeightRequest="130" HorizontalOptions="FillAndExpand"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding LeftMalleolus, StringFormat='Левая лодыжка: {0:F1} мм'}" TextColor="#94A3B8" FontSize="11"/>
                            <Slider Minimum="-15" Maximum="15" Value="{Binding LeftMalleolus}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding RightMalleolus, StringFormat='Правая лодыжка: {0:F1} мм'}" TextColor="#94A3B8" FontSize="11"/>
                            <Slider Minimum="-15" Maximum="15" Value="{Binding RightMalleolus}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- ОСТЕОПАТИЧЕСКИЙ БАРЬЕР -->
                    <Border IsVisible="{Binding IsOsteopathicAlertActive}" BackgroundColor="#450A0A" Stroke="#DC2626" Padding="12" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="⚠ Показано применение дополнительных остеопатических тестов" TextColor="#FCA5A5" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Выполните маневр Вебера-Барстоу для дифференциации перекоса таза:" TextColor="#E2E8F0" FontSize="11"/>
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Анатомическое" Command="{Binding SetDiscrepancyTypeCommand}" CommandParameter="TrueAnatomical" BackgroundColor="#DC2626" TextColor="White" HeightRequest="38" CornerRadius="8"/>
                                <Button Text="Функциональное (Таз)" Command="{Binding SetDiscrepancyTypeCommand}" CommandParameter="FunctionalPelvic" BackgroundColor="#B91C1C" TextColor="White" HeightRequest="38" CornerRadius="8"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding DiscrepancyNature, StringFormat='Текущий статус: {0}'}" TextColor="#FEF08A" FontSize="10" FontAttributes="Italic"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ШАГ 2: ТЕСТ РОТАТОРОВ (ГРУШЕВИДНЫЕ МЫШЦЫ) -->
            <Border BackgroundColor="#1E293B" Padding="14" Stroke="#334155" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Тест 2: Тест ротаторов (Грушевидные мышцы)" TextColor="#38BDF8" FontAttributes="Bold" FontSize="14"/>
                    <Label Text="Оценка пассивной внутренней ротации бедер на кушетке." TextColor="#94A3B8" FontSize="11"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Label Text="Выявлен гипертонус / наружный разворот стоп" TextColor="White" VerticalOptions="Center" FontSize="12"/>
                        <Switch Grid.Column="1" IsToggled="{Binding PiriformisTension}" OnColor="#0284C7" ThumbColor="#38BDF8"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ШАГ 3: ИЗОЛИРОВАННАЯ РОТАЦИЯ БЕДРА -->
            <Border BackgroundColor="#1E293B" Padding="14" Stroke="#334155" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Тест 3: Изолированная ротация шейки бедра" TextColor="#38BDF8" FontAttributes="Bold" FontSize="14"/>
                    <Label Text="Дифференциация торсии бедра и характера суставного барьера." TextColor="#94A3B8" FontSize="11"/>

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Антеторсия" Command="{Binding ToggleAntetorsionCommand}" 
                                BackgroundColor="{Binding Antetorsion, Converter={StaticResource EnumToColorConverter}, ConverterParameter='True'}"
                                TextColor="White" CornerRadius="8" HeightRequest="38"/>
                        <Button Text="Ретроторсия" Command="{Binding ToggleRetrotorsionCommand}" 
                                BackgroundColor="{Binding Retrotorsion, Converter={StaticResource EnumToColorConverter}, ConverterParameter='True'}"
                                TextColor="White" CornerRadius="8" HeightRequest="38"/>
                    </HorizontalStackLayout>

                    <Label Text="Характер барьера вращения:" TextColor="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Мышечный (функциональный)" Command="{Binding SetBarrierTypeCommand}" CommandParameter="MuscleFunctional" 
                                BackgroundColor="{Binding Barrier, Converter={StaticResource EnumToColorConverter}, ConverterParameter='MuscleFunctional'}" 
                                TextColor="White" CornerRadius="8" HeightRequest="36" FontSize="11"/>
                        <Button Text="Костный (анатомический)" Command="{Binding SetBarrierTypeCommand}" CommandParameter="BoneAnatomical" 
                                BackgroundColor="{Binding Barrier, Converter={StaticResource EnumToColorConverter}, ConverterParameter='BoneAnatomical'}" 
                                TextColor="White" CornerRadius="8" HeightRequest="36" FontSize="11"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ШАГ 4: ТОРСИЯ ГОЛЕНИ (ПАЛИМПСЕСТ) -->
            <Border BackgroundColor="#1E293B" Padding="14" Stroke="#334155" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Тест 4: Торсия большеберцовой кости относительно мыщелков" TextColor="#38BDF8" FontAttributes="Bold" FontSize="14"/>
                    <GraphicsView x:Name="TibialGraphicsView" HeightRequest="150" HorizontalOptions="FillAndExpand"/>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Button Text="Недокрут внутрь" Command="{Binding SetTibialStateCommand}" CommandParameter="UnderRotationInward" 
                                BackgroundColor="{Binding TibialState, Converter={StaticResource EnumToColorConverter}, ConverterParameter='UnderRotationInward'}" 
                                TextColor="White" CornerRadius="8" HeightRequest="38" FontSize="12"/>
                        <Button Text="Норма" Command="{Binding SetTibialStateCommand}" CommandParameter="Normal" 
                                BackgroundColor="{Binding TibialState, Converter={StaticResource EnumToColorConverter}, ConverterParameter='Normal'}" 
                                TextColor="White" CornerRadius="8" HeightRequest="38" FontSize="12"/>
                        <Button Text="Перекрут кнаружи" Command="{Binding SetTibialStateCommand}" CommandParameter="OverRotationOutward" 
                                BackgroundColor="{Binding TibialState, Converter={StaticResource EnumToColorConverter}, ConverterParameter='OverRotationOutward'}" 
                                TextColor="White" CornerRadius="8" HeightRequest="38" FontSize="12"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ШАГ 5: ДИНАМИЧЕСКИЕ МАРКЕРЫ (FORMTHOTICS) И УРОВЕНЬ АКТИВНОСТИ -->
            <Border BackgroundColor="#1E293B" Padding="14" Stroke="#334155" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Тест 5: Динамические пробы и активность пациента" TextColor="#38BDF8" FontAttributes="Bold" FontSize="14"/>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Стопа заваливается внутрь (5-й тест Formthotics)" TextColor="White" FontSize="12" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding FallsInwardTest5}" OnColor="#0284C7" ThumbColor="#38BDF8"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Пациент заваливается кнаружи при динамической пробе" TextColor="White" FontSize="12" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding FallsOutwardTest5}" OnColor="#0284C7" ThumbColor="#38BDF8"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Неврома Мортона / Синдром тарзального канала / Нейропатия" TextColor="White" FontSize="12" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding HasMortonOrNeuropathy}" OnColor="#10B981" ThumbColor="#34D399"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Узкая модельная обувь (Low-Volume / без запаса объема)" TextColor="White" FontSize="12" VerticalOptions="Center"/>
                        <Switch Grid.Column="1" IsToggled="{Binding IsNarrowFootwear}" OnColor="#A855F7" ThumbColor="#C084FC"/>
                    </Grid>

                    <Label Text="Уровень метаболической и спортивной активности:" TextColor="#94A3B8" FontSize="11" Margin="0,4,0,0"/>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Text="Малоакт." Command="{Binding SetActivityLevelCommand}" CommandParameter="Sedentary" 
                                BackgroundColor="{Binding Activity, Converter={StaticResource EnumToColorConverter}, ConverterParameter='Sedentary'}" 
                                TextColor="White" CornerRadius="8" FontSize="10" HeightRequest="36"/>
                        <Button Grid.Column="1" Text="Умерен." Command="{Binding SetActivityLevelCommand}" CommandParameter="Moderate" 
                                BackgroundColor="{Binding Activity, Converter={StaticResource EnumToColorConverter}, ConverterParameter='Moderate'}" 
                                TextColor="White" CornerRadius="8" FontSize="10" HeightRequest="36"/>
                        <Button Grid.Column="2" Text="Высокий" Command="{Binding SetActivityLevelCommand}" CommandParameter="Active" 
                                BackgroundColor="{Binding Activity, Converter={StaticResource EnumToColorConverter}, ConverterParameter='Active'}" 
                                TextColor="White" CornerRadius="8" FontSize="10" HeightRequest="36"/>
                        <Button Grid.Column="3" Text="Спорт" Command="{Binding SetActivityLevelCommand}" CommandParameter="Athlete" 
                                BackgroundColor="{Binding Activity, Converter={StaticResource EnumToColorConverter}, ConverterParameter='Athlete'}" 
                                TextColor="White" CornerRadius="8" FontSize="10" HeightRequest="36"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ГЛАВНАЯ КНОПКА РАСЧЕТА КЛИНЬЕВ -->
            <Button Text="Выполнить биомеханический расчет клиньев" 
                    Command="{Binding RunEvaluationCommand}"
                    IsEnabled="{Binding CanCalculate}"
                    BackgroundColor="#0284C7" TextColor="White" FontAttributes="Bold" HeightRequest="50" CornerRadius="12"/>

            <!-- ПРЕДУПРЕЖДЕНИЕ ПРИ БЛОКИРОВКЕ РАСЧЕТА -->
            <Label Text="⚠ Расчет заблокирован: требуется выполнить маневр Вебера-Барстоу (Тест 1)" 
                   TextColor="#EF4444" FontSize="11" HorizontalOptions="Center" 
                   IsVisible="{Binding CanCalculate, Converter={StaticResource InvertedBoolConverter}}"/>

            <!-- СТАТУСНОЕ УВЕДОМЛЕНИЕ -->
            <Label Text="{Binding StatusNotification}" TextColor="#38BDF8" FontSize="12" HorizontalOptions="Center" FontAttributes="Italic"/>

            <!-- РЕЗУЛЬТИРУЮЩИЙ БЛОК: КЛИНИЧЕСКОЕ ЗАКЛЮЧЕНИЕ И ИНТЕРФЕРЕНЦИОННАЯ СТОЯЧАЯ ВОЛНА -->
            <Border IsVisible="{Binding EvaluationResult, Converter={StaticResource NotNullConverter}}" BackgroundColor="#1E293B" Padding="14" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Спецификация индивидуальной коррекции:" TextColor="#38BDF8" FontAttributes="Bold" FontSize="14"/>

                    <!-- КАНВАС 1: ПРОФИЛЬ КЛИНА И СТОЯЧАЯ ВОЛНА СТРЕССА -->
                    <GraphicsView x:Name="AdaptiveWedgeGraphicsView" HeightRequest="100"/>

                    <!-- КАНВАС 2: ПЛАНТАРНАЯ КАРТА СТЕЛЬКИ С ТОПОГРАФИЕЙ КЛИНЬЕВ -->
                    <Label Text="Топография наложения клиньев на стельке:" TextColor="#94A3B8" FontSize="11"/>
                    <GraphicsView x:Name="PlantarMapGraphicsView" HeightRequest="190"/>

                    <!-- СПИСОК ВЫПИСАННЫХ КЛИНЬЕВ -->
                    <Label Text="Назначенные элементы и технологическая спецификация:" TextColor="#E2E8F0" FontSize="13" FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding EvaluationResult.Prescriptions}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:WedgeItemPrescription">
                                <Border BackgroundColor="#0F172A" 
                                        Margin="0,5" 
                                        Padding="14" 
                                        StrokeShape="RoundRectangle 12" 
                                        Stroke="{Binding MapColorHex, Converter={StaticResource HexColorToColorConverter}}" 
                                        StrokeThickness="1.5">
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Верхняя строка: Название и толщина -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding TitleRu}" TextColor="White" FontAttributes="Bold" FontSize="13"/>
                                                <Label Text="{Binding AnatomicalZone}" TextColor="#94A3B8" FontSize="10"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="0">
                                                <Label Text="{Binding EffectiveThicknessMm, StringFormat='{0:F1} мм'}" 
                                                       TextColor="{Binding MapColorHex, Converter={StaticResource HexColorToColorConverter}}" 
                                                       FontAttributes="Bold" FontSize="18" HorizontalTextAlignment="End"/>
                                                <Label Text="{Binding NominalThicknessMm, StringFormat='из {0:F1} мм'}" 
                                                       TextColor="#64748B" FontSize="10" HorizontalTextAlignment="End"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Бейдж адаптивного демпфирования при переполнении сегмента -->
                                        <Border IsVisible="{Binding IsSegmentClamped}" BackgroundColor="#451A03" Stroke="#F59E0B" Padding="8,3" StrokeShape="RoundRectangle 6" HorizontalOptions="Start">
                                            <Label Text="🛡️ АДАПТИВНО СЖАТО (Лимит сегмента 6.0 мм)" TextColor="#FCD34D" FontSize="9" FontAttributes="Bold"/>
                                        </Border>

                                        <!-- Биомеханический вектор сил и разгрузки -->
                                        <Label Text="{Binding ForceVectorRationale}" TextColor="#CBD5E1" FontSize="11" LineBreakMode="WordWrap"/>

                                        <!-- Прозрачная формула адаптивного расчета -->
                                        <Border BackgroundColor="#1E293B" Padding="8,5" StrokeShape="RoundRectangle 6" Stroke="#334155">
                                            <Label Text="{Binding AdaptiveFormulaBreakdown, StringFormat='📐 Формула: {0}'}" TextColor="#38BDF8" FontSize="10"/>
                                        </Border>

                                        <!-- Мета-информация: Квадрант, Материал, Контроль -->
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                            <Border Grid.Column="0" BackgroundColor="#1E293B" Padding="6,3" StrokeShape="RoundRectangle 6">
                                                <Label Text="{Binding InsoleQuadrant, Converter={StaticResource QuadrantToBadgeConverter}}" TextColor="#94A3B8" FontSize="9" HorizontalTextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" BackgroundColor="#1E293B" Padding="6,3" StrokeShape="RoundRectangle 6">
                                                <Label Text="{Binding RecommendedDurometer, Converter={StaticResource DurometerToBadgeConverter}}" TextColor="#A78BFA" FontSize="9" HorizontalTextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="2" BackgroundColor="#1E293B" Padding="6,3" StrokeShape="RoundRectangle 6">
                                                <Label Text="{Binding ControlTestMandate, StringFormat='Контроль: {0}'}" TextColor="#34D399" FontSize="9" HorizontalTextAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Регламент монтажа для техника-ортезиста -->
                                        <Border BackgroundColor="#1E293B" Padding="8,6" StrokeShape="RoundRectangle 6" Stroke="#334155">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="🔧 Регламент монтажа мастеру:" TextColor="#E2E8F0" FontSize="10" FontAttributes="Bold"/>
                                                <Label Text="{Binding InstallationProtocol}" TextColor="#94A3B8" FontSize="10" LineBreakMode="WordWrap"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- ИНДЕКС КИНЕМАТИЧЕСКОГО РИСКА (KRS) -->
                    <Border BackgroundColor="#0F172A" Padding="12" StrokeShape="RoundRectangle 10" Stroke="{Binding EvaluationResult.KineticRiskScore, Converter={StaticResource KrsToColorConverter}}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="ИНДЕКС КИНЕМАТИЧЕСКОГО РИСКА (KRS)" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"/>
                                <Label Text="{Binding EvaluationResult.KineticRiskScore, Converter={StaticResource KrsToBadgeConverter}}" 
                                       TextColor="{Binding EvaluationResult.KineticRiskScore, Converter={StaticResource KrsToColorConverter}}" 
                                       FontSize="12" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding EvaluationResult.KineticRiskScore, StringFormat='{0:F0}%'}" 
                                   TextColor="{Binding EvaluationResult.KineticRiskScore, Converter={StaticResource KrsToColorConverter}}" 
                                   FontSize="22" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- ДИНАМИЧЕСКИЕ КЛИНИЧЕСКИЕ АЛЕРТЫ И ПРОТИВОПОКАЗАНИЯ (НЕ ОТОБРАЖАТЬ ПУСТЫЕ КАРТОЧКИ) -->
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding EvaluationResult.DynamicAlerts.Count, Converter={StaticResource NotNullOrEmptyConverter}}">
                        <Label Text="Клинические алерты и противопоказания:" TextColor="#FCA5A5" FontSize="13" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding EvaluationResult.DynamicAlerts}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="domain:ClinicalAlertItem">
                                    <Border BackgroundColor="{Binding Severity, Converter={StaticResource AlertSeverityToBackgroundConverter}}" 
                                            Stroke="{Binding Severity, Converter={StaticResource AlertSeverityToColorConverter}}" 
                                            StrokeThickness="1.5"
                                            Padding="12" 
                                            Margin="0,4" 
                                            StrokeShape="RoundRectangle 10"
                                            IsVisible="{Binding Title, Converter={StaticResource NotNullOrEmptyConverter}}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Severity, Converter={StaticResource AlertSeverityToBadgeConverter}}" 
                                                       TextColor="{Binding Severity, Converter={StaticResource AlertSeverityToColorConverter}}" 
                                                       FontSize="11" FontAttributes="Bold"/>
                                                <Border Grid.Column="1" BackgroundColor="#0F172A" Padding="6,2" StrokeShape="RoundRectangle 6">
                                                    <Label Text="{Binding AffectedSegment, Converter={StaticResource AnatomicalSegmentToNameConverter}}" TextColor="#94A3B8" FontSize="9"/>
                                                </Border>
                                            </Grid>

                                            <Label Text="{Binding Title}" TextColor="White" FontSize="12" FontAttributes="Bold"
                                                   IsVisible="{Binding Title, Converter={StaticResource NotNullOrEmptyConverter}}"/>

                                            <Label Text="{Binding BiomechanicalRationale}" TextColor="#CBD5E1" FontSize="11" LineBreakMode="WordWrap"
                                                   IsVisible="{Binding BiomechanicalRationale, Converter={StaticResource NotNullOrEmptyConverter}}"/>

                                            <!-- Адаптивный протокол подиатра показывается ТОЛЬКО если есть текст (не показывать пустые карточки/блоки!) -->
                                            <Border BackgroundColor="#0F172A" Padding="10" StrokeShape="RoundRectangle 8" Stroke="#38BDF8" StrokeThickness="1" Margin="0,4,0,0"
                                                    IsVisible="{Binding AdaptiveActionPlan, Converter={StaticResource NotNullOrEmptyConverter}}">
                                                <VerticalStackLayout Spacing="4">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="📋" FontSize="11" VerticalOptions="Center"/>
                                                        <Label Text="Адаптивный протокол подиатра:" TextColor="#38BDF8" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding AdaptiveActionPlan}" TextColor="#E2E8F0" FontSize="11" LineBreakMode="WordWrap"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- ИНДИВИДУАЛЬНЫЙ ГРАФИК НОШЕНИЯ (НЕ ОТОБРАЖАТЬ ПУСТЫЕ СТРОКИ) -->
                    <VerticalStackLayout Spacing="4" Margin="0,6,0,0"
                                         IsVisible="{Binding EvaluationResult.WearInSchedule.Count, Converter={StaticResource NotNullOrEmptyConverter}}">
                        <Label Text="Протокол адаптации и реабилитации:" TextColor="#93C5FD" FontSize="12" FontAttributes="Bold"/>
                        <CollectionView ItemsSource="{Binding EvaluationResult.WearInSchedule}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <HorizontalStackLayout Spacing="6" Margin="0,2"
                                                           IsVisible="{Binding ., Converter={StaticResource NotNullOrEmptyConverter}}">
                                        <Label Text="✓" TextColor="#38BDF8" FontSize="11" FontAttributes="Bold" VerticalOptions="Start"/>
                                        <Label Text="{Binding .}" TextColor="#CBD5E1" FontSize="11" LineBreakMode="WordWrap"/>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- ПОДРОБНЫЙ АДАПТИВНЫЙ ПОДИАТРИЧЕСКИЙ ПРОТОКОЛ FORMTHOTICS -->
                    <views:AdaptiveProtocolView BindingContext="{Binding}" Margin="0,8,0,0"/>

                    <!-- КНОПКИ ПРОСМОТРА И ЭКСПОРТА ПРОТОКОЛА В PDF -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Text="📄 Просмотр протокола (A4)" 
                                Command="{Binding ShowPrintProtocolCommand}"
                                BackgroundColor="#0284C7" TextColor="White" FontAttributes="Bold" HeightRequest="44" CornerRadius="10"/>

                        <Button Grid.Column="1"
                                Text="💾 Экспорт в PDF (A4)" 
                                Command="{Binding ExportPdfProtocolCommand}"
                                BackgroundColor="#059669" TextColor="White" FontAttributes="Bold" HeightRequest="44" CornerRadius="10"/>
                    </Grid>

                    <!-- КНОПКА АТОМАРНОГО СОХРАНЕНИЯ В ЗАШИФРОВАННУЮ БД -->
                    <Button Text="Сохранить в зашифрованную медицинскую карту" 
                            Command="{Binding SaveExamRecordCommand}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" HeightRequest="46" CornerRadius="10" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

    <!-- ОВЕРЛЕЙ: ГОТОВЫЙ К ПЕЧАТИ ПРОТОКОЛ С УТВЕРЖДЕНИЕМ ВРАЧОМ -->
    <views:PrintableProtocolModalView Grid.Row="0" 
                                     IsVisible="{Binding IsPrintProtocolVisible}" 
                                     BindingContext="{Binding}"/>
</Grid>
</ContentPage>
